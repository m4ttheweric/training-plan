  "id": "half-get-in-gear-2027",
  "name": "Half Marathon Plan",
  "subtitle": "Oct 5, 2026 -- Apr 24, 2027 · 29 weeks · 4 runs + 3 lifts/wk · recovery week → 12-wk base → 16-wk race build → Get in Gear Half",
  "startDate": "2026-10-05",
  "race": {
    "name": "Get in Gear Half Marathon",
    "date": "2027-04-24",
    "distance": 13.1,
    "targetPace": "~9:10/mi",
    "targetTime": "2:00-2:03"
  },
  "phases": [
    {
      "id": "recover",
      "name": "Recover",
      "tag": "Post-10K · wk 1",
      "type": "recovery",
      "description": "The week after the TC 10K. Every run is easy by heart rate (Zone 2, ≤147), with no strides or quality, and lifts are light. The plan proper starts next Monday with a 6-mile long run.",
      "weeks": [
        1
      ]
    },
    {
      "id": "base-easy",
      "name": "Base",
      "tag": "Easy volume · wk 2-5",
      "description": "Absorb the 10K and rebuild the week around frequency. Every run is easy by heart rate (Zone 2, ≤147). Strides return on Wednesday from week 3. Weeks 2-13 run three build weeks to one cutback: the work is nearly all easy, so the recovery cost per week is low.",
      "weeks": [
        2,
        3,
        4,
        5
      ]
    },
    {
      "id": "base-hills",
      "name": "Base",
      "tag": "Hills · wk 6-9",
      "description": "Friday becomes hill repeats, 6 growing to 8 reps. Hills build power and economy with less pounding than flat speed. The long run grows half a mile at a time toward 8.",
      "weeks": [
        6,
        7,
        8,
        9
      ]
    },
    {
      "id": "base-fartlek",
      "name": "Base",
      "tag": "Fartlek · wk 10-13",
      "description": "Friday shifts to 1-minute pickups at 10K effort: the first sustained faster running of the plan, still unstructured. The long run reaches 9 miles by Christmas week. Week 13 is a cutback before the race build starts.",
      "weeks": [
        10,
        11,
        12,
        13
      ]
    },
    {
      "id": "threshold",
      "name": "Threshold",
      "tag": "Race build · wk 14-19",
      "description": "Lactate threshold is the strongest predictor of half-marathon time, so it comes first. Friday is cruise intervals at T pace (8:45-8:55/mi), building to a continuous tempo. From here the rhythm is two build weeks to one cutback: quality day plus a 9-10 mile long run every week costs more to absorb after 40.",
      "weeks": [
        14,
        15,
        16,
        17,
        18,
        19
      ]
    },
    {
      "id": "race-specific",
      "name": "Race-specific",
      "tag": "Race build · wk 20-25",
      "description": "Friday alternates half-marathon-pace runs (3 to 4 miles at 9:10/mi) with threshold intervals. Every other long run finishes with 2 miles at HMP. Week 25 is a cutback with a tune-up race on Friday: that result sets the final race pace and decides whether sub-2:00 is on.",
      "weeks": [
        20,
        21,
        22,
        23,
        24,
        25
      ]
    },
    {
      "id": "peak",
      "name": "Peak",
      "tag": "Race build · wk 26-27",
      "description": "Two 11-mile long runs; the second finishes with 3 miles at goal pace. Friday of week 26 is a 5-mile dress rehearsal at HMP. The last long run lands 19 days before the race.",
      "weeks": [
        26,
        27
      ]
    },
    {
      "id": "taper",
      "name": "Taper",
      "tag": "Race prep · wk 28",
      "type": "recovery",
      "description": "Cut volume ~30%, keep frequency and a short HMP segment so the legs stay sharp. All three lifts drop ~30% in weight.",
      "weeks": [
        28
      ]
    },
    {
      "id": "race",
      "name": "Race week",
      "tag": "Get in Gear · Apr 24",
      "type": "race",
      "description": "Minimal running: easy Monday, strides Wednesday, a 2-mile shakeout Thursday, rest Friday. No deadlift and no squat: the race replaces them. Bench and upper body stay light.",
      "weeks": [
        29
      ]
    }
  ],
  "afterPlan": {
    "name": "After the race",
    "tag": "Steady state",
    "description": "Take 4-5 easy days (a half costs more than the 10K did), then return to the week 10-13 pattern as a repeating cycle at ~20 mi/week until the next goal is set."
  },
