{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:training-plan:schema",
  "title": "Training plan",
  "description": "Weekly plans anchored on Monday. All distances are miles; dates are local calendar dates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "subtitle", "startDate", "phases", "weeks", "glossary", "rules", "callout"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/definitions/id" },
    "name": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "startDate": { "type": "string", "format": "date" },
    "race": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "date", "distance", "targetPace", "targetTime"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "distance": { "type": "number", "exclusiveMinimum": 0 },
        "targetPace": { "type": "string" },
        "targetTime": { "type": "string" }
      }
    },
    "phases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/phase" } },
    "afterPlan": { "$ref": "#/definitions/description" },
    "weeks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/week" } },
    "glossary": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["term", "definition"],
        "properties": { "term": { "type": "string", "minLength": 1 }, "definition": { "type": "string" } }
      }
    },
    "rules": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "text"],
        "properties": { "label": { "type": "string", "minLength": 1 }, "text": { "type": "string" } }
      }
    },
    "callout": { "type": "string" }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": {
      "type": "object", "additionalProperties": false, "required": ["name", "tag", "description"],
      "properties": { "name": { "type": "string" }, "tag": { "type": "string" }, "description": { "type": "string" } }
    },
    "phase": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "tag", "description", "weeks"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "weeks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }
      }
    },
    "week": {
      "type": "object", "additionalProperties": false, "required": ["week", "days"],
      "properties": {
        "week": { "type": "integer", "minimum": 1 },
        "recovery": { "type": "boolean" },
        "days": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/definitions/day" } }
      }
    },
    "day": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["run", "long", "lift", "rest", "race"] },
        "miles": { "type": "number", "exclusiveMinimum": 0 },
        "label": { "type": "string" },
        "detail": { "type": "string" },
        "reps": { "type": "integer", "minimum": 1 },
        "newSlot": { "type": "boolean" }
      },
      "if": { "properties": { "type": { "enum": ["run", "long", "race"] } }, "required": ["type"] },
      "then": { "required": ["miles"] }
    }
  }
}
