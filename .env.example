# The app runs without Strava or Claude. Copy this file to .env to customize it.
PORT=8081
HOST=127.0.0.1
# Leave blank to derive http://localhost:<PORT>.
BASE_URL=
# Match a file in plans/: PLAN_ID=10k-oct-2026 (omit .json).
# Leave blank to prefer a current plan, then the latest past or earliest future plan.
PLAN_ID=
# Optional custom database directory; relative paths resolve from the working directory.
DATA_DIR=

# Optional Strava app credentials. Connect from the Journal page after setting these.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional existing tokens; the browser OAuth flow fills the database instead.
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# Optional run analysis, using your authenticated Claude Code CLI.
FEEDBACK_ENABLED=false
# Leave blank to use Claude's current account. Set an email only if you use cswap.
FEEDBACK_CLAUDE_ACCOUNT=
